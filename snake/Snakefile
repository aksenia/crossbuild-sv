import os

# No default configfile: always pass --configfile, so a template value can
# never silently leak into a real run.
if not config:
    raise ValueError("pass a config with --configfile (see snake/config.yaml)")

container: config.get("container_image", "docker://crossbuild-sv:latest")

SAMPLE  = config["sample"]
RESULTS = config["results_dir"]
SCRIPTS = "/app/liftover"

rule all:
    input:
        f"{RESULTS}/annotated/source/{SAMPLE}.hg19.annotated.vcf.gz",
        f"{RESULTS}/annotated/merged/{SAMPLE}.merged.hg38.annotated.vcf.gz",
        f"{RESULTS}/annotated/merged/{SAMPLE}.refchanged.hg38.annotated.vcf.gz"

include: "rules/liftover.smk"
include: "rules/annotations.smk"
